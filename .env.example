# Copie este arquivo para ".env" na raiz do projeto e ajuste os valores antes
# de rodar "docker compose up -d". NUNCA versione o arquivo ".env" real no Git.

# --- Banco de dados ---
POSTGRES_DB=monitoramento
POSTGRES_USER=monitoramento
POSTGRES_PASSWORD=troque-esta-senha

# --- Segurança ---
# Gere um valor aleatório com pelo menos 32 caracteres, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=troque-este-segredo-em-producao-com-no-minimo-32-caracteres
JWT_EXPIRATION_MS=28800000

# Segredo usado para cifrar a senha das câmeras no banco (AES). Gere com o
# mesmo comando acima.
CAMERA_CREDENTIAL_SECRET=troque-este-segredo-em-producao

# --- CORS ---
# URL(s) do frontend autorizadas a chamar a API, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- Streaming / Disco ---
HLS_INATIVIDADE_TIMEOUT=60
DISCO_PATH_PADRAO=/
